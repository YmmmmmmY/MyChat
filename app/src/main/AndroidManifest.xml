        android:label="@string/app_name"
        android:roundIcon="@drawable/p"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <service
            android:name=".MusicService"
            android:enabled="true"
            android:exported="true"></service>

        <activity
